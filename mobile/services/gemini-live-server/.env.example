# Gemini Live proxy — environment variables
SUPABASE_ANON_KEY=
GEMINI_API_KEY=your_gemini_key_here
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
PORT=8080
LIVE_AUTH_TIMEOUT_MS=8000
LIVE_IDLE_TIMEOUT_MS=45000
LIVE_MAX_SESSION_MS=900000
LIVE_USER_SESSIONS_PER_DAY=20
LIVE_GLOBAL_SESSIONS_PER_MINUTE=60
LIVE_MAX_CONNECTIONS_PER_USER=1
LIVE_MAX_GLOBAL_CONNECTIONS=20
LIVE_MAX_MESSAGE_BYTES=1048576
