{
  "expo": {
    "name": "Aboy AI",
    "slug": "aboy-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aboyai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aboy AI uses the microphone so you can ask questions by voice.",
        "NSSpeechRecognitionUsageDescription": "Aboy AI converts your speech to text so you can ask questions by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#d9f0f8"
      },
      "package": "com.aboyai.app",
      "versionCode": 4,
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aboy AI accesses your photos so you can upload a textbook page, diagram, or clinical image for it to explain."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aboy AI uses the camera so you can ask about textbook pages, notes, diagrams, and clinical images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0a5f52",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Aboy AI uses the microphone so you can ask questions by voice.",
          "speechRecognitionPermission": "Aboy AI converts your speech to text so you can ask questions by voice."
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ]
    ],
    "scheme": "aboyai",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "72f9ee22-4dfa-47ab-b2d4-249349f4cd91"
      }
    },
    "owner": "aboyai",
    "updates": {
      "url": "https://u.expo.dev/72f9ee22-4dfa-47ab-b2d4-249349f4cd91"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
