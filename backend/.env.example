ENVIRONMENT=production
LOG_LEVEL=info

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=
MIGRATION_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage AI
VOYAGE_API_KEY=

# Tavily
TAVILY_API_KEY=

# Gemini (voice transcription + vision + Live API proxy at /ws/live)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional answer providers (required only when selected by LLM_PROVIDER)
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter

# Redis (cache + rate limiting)
REDIS_URL=

# Provider spend and abuse controls
PROVIDER_USER_REQUESTS_PER_MINUTE=20
PROVIDER_GLOBAL_REQUESTS_PER_MINUTE=200
PROVIDER_MAX_TEXT_CHARS=40000
PROVIDER_MAX_UPLOAD_BYTES=20971520
PROVIDER_TIMEOUT_SECONDS=75

# Gemini Live controls
LIVE_AUTH_TIMEOUT_SECONDS=8
LIVE_IDLE_TIMEOUT_SECONDS=45
LIVE_MAX_SESSION_SECONDS=900
LIVE_SESSIONS_PER_USER_PER_DAY=20
LIVE_GLOBAL_SESSIONS_PER_MINUTE=60
LIVE_MAX_CONNECTIONS_PER_USER=1
LIVE_MAX_GLOBAL_CONNECTIONS=20
LIVE_MAX_MESSAGE_BYTES=1048576

# App settings
ALLOWED_ORIGINS=*
DISCORD_FEEDBACK_ENABLED=false
