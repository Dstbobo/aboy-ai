ENVIRONMENT=production
LOG_LEVEL=info

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=
MIGRATION_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage AI
VOYAGE_API_KEY=

# Tavily
TAVILY_API_KEY=

# Gemini (voice transcription + vision + Live API proxy at /ws/live)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional answer providers (required only when selected by LLM_PROVIDER)
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter

# Redis (cache + rate limiting)
REDIS_URL=

# App settings
ALLOWED_ORIGINS=*
